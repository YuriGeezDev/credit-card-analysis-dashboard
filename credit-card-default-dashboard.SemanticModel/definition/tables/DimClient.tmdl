table DimClient
	lineageTag: 10ad7603-6342-41e0-8c50-7165eee2f0e8

	column ClientID
		dataType: int64
		formatString: 0
		lineageTag: 575f4079-5d3f-4dc4-b758-a869e1e53cbe
		summarizeBy: none
		isNameInferred
		sourceColumn: [ClientID]

	column ClientName
		dataType: string
		lineageTag: d09e0239-31b1-47fb-bdac-ce18cb8b6db6
		summarizeBy: none
		isNameInferred
		sourceColumn: [ClientName]

	partition DimClient = calculated
		mode: import
		source =
				SUMMARIZE(
				    UNION(
				        SELECTCOLUMNS(Top50Clients, "ClientID", Top50Clients[ClientID], "ClientName", Top50Clients[ClientName]),
				        SELECTCOLUMNS(Top50OverduePayments, "ClientID", Top50OverduePayments[ClientID], "ClientName", Top50OverduePayments[ClientName])
				    ),
				    [ClientID], [ClientName]
				)

	annotation PBI_ResultType = Table

